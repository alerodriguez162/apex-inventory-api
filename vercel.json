{
  "version": 2,
  "installCommand": "npm install && npm rebuild better-sqlite3",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["openapi/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.ts" }
  ]
}
